<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Payroll</title>
  <style>

    /* Reserve room on every page for the Puppeteer-injected header/footer.
       generate.js extracts the header and footer elements from this template
       and passes them to Puppeteer's displayHeaderFooter so they repeat on
       each page. */
    @page {
      /* Top reserves room for the 100px header element AND the 120px logo
         that overflows below it (≈140px total). Bottom fits the 60px
         footer + a small cushion so its border-top isn't flush with content. */
      margin: 145px 20px 75px 20px; /* top, right, bottom, left */
    }

    html, body {
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      font-size: 14px;
      color: #333;
    }

    @media print {
      body { font-size: 12pt; color: black; }
      .no-print { display: none; }
    }

    /* Header/footer styles live INLINE on the elements themselves (not here)
       because Puppeteer's per-page header/footer template runs in an isolated
       context where class-based styles don't reliably apply. */

    .company-info { text-align: right; }
    .company-info .name {
      font-weight: bold;
      font-size: 18px;
      text-transform: uppercase;
    }

    .watermark {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-30deg);
      opacity: 0.15;
      z-index: 0;
      width: 450px;
      height: auto;
      pointer-events: none;
    }

    .content, .summary, .signature {
      position: relative;
      z-index: 1;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
      table-layout: fixed;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 4px;
      text-align: left;
      word-wrap: break-word;
      vertical-align: top;
    }

    th { background-color: #f5f5f5; }

    /* Keep table rows from splitting mid-row across pages */
    tr { page-break-inside: avoid; break-inside: avoid; }
    thead { display: table-header-group; }       /* repeat headers on each page */
    tfoot { display: table-footer-group; }

    .summary {
      margin-top: 20px;
      font-size: 12px;
    }

    /* Two-column summary: narrow label, wide value */
    .summary table { table-layout: fixed; }
    .summary td:first-child { width: 30%; }

    .signature {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-top: 20px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .signature .col {
      flex: 1 1 0;
      min-width: 0;            /* allow shrinking; was forcing wrap */
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .page-break {
      page-break-before: always;
    }

    .section-title {
      font-size: 18px;
      font-weight: bold;
      text-align: center;
      margin-bottom: 15px;
      margin-top: 10px;
    }

  </style>
</head>

<body>
    <img src="data:image/png;base64,{{data.attachments.0.fileData}}" class="watermark" alt="Watermark" />
    <header style="box-sizing: border-box; width: 100%; height: 100px; margin: 0; padding: 10px 40px; border-bottom: 1px solid #000; background: white; font-family: Arial, sans-serif; color: #333; -webkit-print-color-adjust: exact;">
      <div style="display: flex; justify-content: space-between; align-items: center; height: 100%;">
        <div><img src="data:image/png;base64,{{data.attachments.0.fileData}}" alt="Logo" style="height: 120px;" /></div>
        <div style="text-align: right;">
          <div style="font-weight: bold; font-size: 18px; text-transform: uppercase;">HA TRANSPORTATION NW LLC</div>
          <div>23406 Pacific Ave S, Ste 106</div>
          <div>Kent, WA 98032</div>
          <div>+1 (253) 237-2479</div>
        </div>
      </div>
    </header>

    <div class="content">
      <table>
        <thead>
          <tr>
            <th>Dispatch #</th>
            <th>Load #</th>
            <th>Truck</th>
            <th>Status</th>
            <th>PU Date</th>
            <th>Delivery</th>
            <th>From (City, State)</th>
            <th>To (City, State)</th>
            <th>Gross</th>
            <th>Dispatch</th>
          </tr>
        </thead>
        <tbody>
          {{#each data.loadData}}
          <tr>
            <td>{{dispatchNumber}}</td>
            <td>{{loadNumber}}</td>
            <td>{{truck}}</td>
            <td>{{status}}</td>
            <td>{{puDate}}</td>
            <td>{{deliveryDate}}</td>
            <td>{{shipperCity}}, {{shipperState}}</td>
            <td>{{receiverCity}}, {{receiverState}}</td>
            <td>{{gross}}</td>
            <td>{{dispatchAmount}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

        <!-- Summary Table -->
    <div class="summary">
      <table>
        <tbody>
          <tr><td><strong>Date</strong></td><td><strong>{{data.date}}</strong></td></tr>
          <tr><td><strong>Total Gross</strong></td><td><strong>{{data.totalGross}}</strong></td></tr>
          <tr><td><strong>Dispatch</strong></td><td><strong>{{data.totaldispatch}}</strong></td></tr>
          <!-- <tr><td><strong>Trailer Rent</strong></td><td><strong>{{data.trailerRent}}</strong></td></tr> -->
          <!-- <tr><td><strong>IFTA</strong></td><td><strong>{{data.ifta}}</strong></td></tr> -->
          <!-- <tr><td><strong>DOT</strong></td><td><strong>{{data.dot}}</strong></td></tr> -->
          <tr><td><strong>Insurance</strong></td><td><strong>{{data.insurance}}</strong></td></tr>
          <tr><td><strong>Fuel</strong></td><td><strong>{{data.fuel}}</strong></td></tr>
          <!-- <tr><td><strong>Local Pickup & Delivery</strong></td><td><strong>{{data.localPickupAndDelivery}}</strong></td></tr> -->
          <tr><td><strong>Misc</strong></td><td><strong>{{data.misc}}</strong></td></tr>
          <!-- <tr><td><strong>Tracking App</strong></td><td><strong>{{data.trackingApp}}</strong></td></tr> -->
          <tr><td><strong>Repairs</strong></td><td><strong>{{data.repairs}}</strong></td></tr>
          <tr><td><strong>Driver Payroll</strong></td><td><strong>{{data.driverPayroll}}</strong></td></tr>
          <tr><td><strong>Notes</strong></td><td>{{data.notes}}</td></tr>
          <tr><td><strong>Net</strong></td><td><strong>{{data.net}}</strong></td></tr>
        </tbody>
      </table>
    </div>

    <div class="signature">
    <div class="col">
      <div class="field"><b>Email: </b> accounting@handatransportation.com</div>
    </div>
    <div class="col" style="background-color: #f2f2f2; border: 1px solid #ccc ; padding: 10px;">
      <div><b>Net Pay: </b></div>
      <div class="field"><b>{{data.net}}</b></div>
      <div style="margin-top: 10px;">
        <p>
          If you have any questions or need further assistance, please don't hesitate to contact us at
          <strong>accounting@handatransportation.com</strong>. We're here to help with any queries related to your statement or documentation.
        </p>
      </div>
    </div>
    </div>

    <div class="page-break"></div>
    <div class="content">
      <div class="section-title">Fuel Report</div>
      <table>
        <thead>
          <tr>
            <th>Transaction Number</th>
            <th>Transaction Date</th>
            <th>TruckStop</th>
            <th>DEF Gallons</th>
            <th>Gross Cost</th>
            <th>Discount</th>
            <th>Total Amt Post Discount</th>
          </tr>
        </thead>
        <tbody>
          {{#each data.fuelData}}
          <tr>
            <td>{{transactionNumber}}</td>
            <td>{{transactionDate}}</td>
            <td>{{truckStop}}</td>
            <td>{{defGallons}}</td>
            <td>{{totalAmount}}</td>
            <td>{{discountOOP}}</td>
            <td>{{totalAmtDueOOP}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

      

    <footer style="box-sizing: border-box; width: 100%; height: 60px; margin: 0; padding: 10px 40px; border-top: 1px solid #ccc; text-align: center; font-size: 11px; color: #666; background: white; font-family: Arial, sans-serif; -webkit-print-color-adjust: exact;">
      <p style="margin: 2px 0;">HA Transportation NW LLC &ndash; 23406 Pacific Ave S, Ste 106, Kent, WA 98032</p>
      <p style="margin: 2px 0;">Phone: +1 (253) 237-2479 | Email: accounting@handatransportation.com</p>
      <p style="margin: 2px 0; font-style: italic;">Thank you for being a valued partner of HA Transportation.</p>
    </footer>


   
</body>

</html>
{{! This is a payroll template for H&A Transportation. It includes the company logo, contact information, and a table for load details. The summary section provides an overview of the financials related to the loads. The document is styled with CSS for a clean and professional appearance. }}
{{! The watermark is included as a fixed image in the background. The document is structured to be printed or saved as a PDF. }}
{{! The template uses Handlebars syntax for dynamic data rendering. }}
{{! The code includes sections for header, load table, summary, and footer with contact information. }}
{{! The signature line is provided for acknowledgment of the document. }}